# Configuration Strava
EXPO_PUBLIC_STRAVA_CLIENT_ID=YOUR_CLIENT_ID
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Configuration de l'URL de redirection (pour le développement)
EXPO_PUBLIC_AUTH_REDIRECT_URI=exp://127.0.0.1:19000/--/auth/callback

# Configuration pour le mode développement
EXPO_PUBLIC_ENV=development
